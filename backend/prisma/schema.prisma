generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id             Int      @id @default(autoincrement())
  organization   String
  asset          String
  finding        String
  severity       String
  priority       String
  why            String   @db.Text
  recommendation String   @db.Text
  timeline       String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("analyses")
}
